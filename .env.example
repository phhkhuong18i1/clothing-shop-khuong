APP_NAME="Atelier No. 8"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=vi
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=atelier
DB_USERNAME=atelier
DB_PASSWORD=change-this-local-app-password

MYSQL_DATABASE=atelier
MYSQL_USER=atelier
MYSQL_PASSWORD=change-this-local-app-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password
MYSQL_FORWARD_PORT=3307

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log

# Thông tin liên hệ mẫu cho cửa hàng demo; thay bằng thông tin thật trước khi vận hành.
STORE_NAME="Atelier No. 8"
STORE_EMAIL=hello@atelier-no8.example
STORE_PHONE=+84 000 000 008
STORE_ADDRESS="08 Atelier Lane, Quận 1, TP. Hồ Chí Minh (thông tin mẫu)"
STORE_INSTAGRAM=https://instagram.com/atelier_no8_demo
STORE_ZALO_URL=https://zalo.me/84900000008
STORE_MESSENGER_URL=https://m.me/atelier.no8.demo
STORE_BADGE_FEATURED="Sản phẩm nổi bật"
STORE_BADGE_BEST_SELLER="Bán chạy"
STORE_BADGE_SALE=Sale

# Chỉ điền các giá trị này trong .env local rồi chạy riêng AdminUserSeeder.
ADMIN_NAME="Quản trị viên"
ADMIN_EMAIL=
ADMIN_PASSWORD=
